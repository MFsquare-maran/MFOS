# MFOS Server: Einstellungen. Diese Datei ist nur eine VORLAGE.
#
# So geht es:
#   Portainer:  Stack -> "Environment variables" -> "Advanced mode" und die Zeilen unten einfuegen.
#   Lokal:      Datei nach ".env" kopieren (steht in .gitignore und kommt nie ins Repository).
#
# Passwoerter: mindestens 20 Zeichen, zufaellig. Erzeuge sie mit
#   sh deploy/tools/gen-secrets.sh        (Linux, Mac, Git Bash)
#   deploy/tools/gen-secrets.ps1          (Windows PowerShell)
# Die Container starten NICHT, wenn ein Passwort zu kurz oder noch ein Platzhalter ist.
# Verwende die Passwoerter nirgends sonst, und schreibe sie nicht in Chats, Tickets oder Git.
#
# Domain und TLS: Das macht dein Reverse Proxy (z. B. mfos.mfsquare.ch). Hier steht dazu nichts.

# ---------- Dashboard-Anmeldung (zusaetzlich zum Proxy, nicht stattdessen) ----------
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME_mindestens_20_zeichen

# ---------- MQTT-Zugaenge ----------
# Der Benutzername des Boots ist seine Kennung: es darf nur mfos/<Benutzername>/... benutzen.
MQTT_BOAT_USER=mfos-1
MQTT_BOAT_PASSWORD=CHANGE_ME_mindestens_20_zeichen
# Fuer das spaetere Backend (im selben Stack). Darf alle Boote lesen und steuern.
MQTT_BACKEND_USER=mfos-backend
MQTT_BACKEND_PASSWORD=CHANGE_ME_mindestens_20_zeichen

# ---------- Anbindung an den Reverse Proxy ----------
# Name des Docker-Netzes, in dem auch dein Proxy haengt. Der Proxy erreicht dann die Dienste als
# "mfos-web" (Port 8080) und "mfos-mosquitto" (Port 1883). Das Netz muss schon existieren.
PROXY_NETWORK=proxy
# Nur noetig, wenn dein Proxy NICHT im Docker-Netz haengt, sondern auf dem Rechner selbst laeuft:
# Ports auf localhost. NICHT auf 0.0.0.0 stellen, wenn der Server aus dem Internet erreichbar ist.
#WEB_BIND=127.0.0.1
#WEB_PORT=8080
#MQTT_BIND=127.0.0.1
#MQTT_PORT=1883

# ---------- Optional: MQTT ueber WebSocket ----------
# Schaltet den WebSocket-Listener von Mosquitto ein. Der Web-Server reicht ihn unter /mqtt durch,
# sodass das Boot ueber die normale HTTPS-Adresse des Proxys (wss://<domain>/mqtt) verbinden kann.
# Nur sinnvoll, wenn die Firmware MQTT ueber WebSocket kann (siehe deploy/README.md).
#MQTT_WEBSOCKETS=true
